<template>
	<view class="com-header" v-if="header">
		<com-navigation :backgroundColor="header.style.bgColor || ''" :bgImg="header.content.bgImg.url || ''"
			:pageBg="pageBg" :showType="header.options.showType" alignItems="normal">
			<view class="navigation-slot" :style="{ paddingLeft: paddingLeft }">
				<view class="default-back" v-if="showBack && !header.search.prefixIcon.url" @click="backPage"></view>
				<view class="prefix-icon" v-if="header.search.isShowPrefixIcon && header.search.prefixIcon.url" :style="iconStyle">
					<image class="img" :src="header.search.prefixIcon.url" mode="heightFix" @load="iconLoad"
						@error="iconError" @click="jumpLink(header.search.prefixLink)"
						></image>
				</view>
				<view class="search-bar" :style="searchStyle" v-if="header.options.type === 2" @click="jumpSearchPage">
					<view class="search-icon">
						<uni-icons type="search" :size="20" :color="header.search.color"></uni-icons>
					</view>
					<view class="search-inp" :style="{
							justifyContent: justifyContent[header.search.textAlign]
						}">
							<text :style="{color: header.search.color, fontSize: transformPixel(header.style.fontSize)}">{{header.search.placeholder}}</text>
					</view>
				</view>
				<view class="search-title" :style="titleStyle" v-else>
					<text :style="titleStyle">{{ header.content.title }}</text>
				</view>
			</view>
		</com-navigation>
	</view>
</template>

<script lang="uts" setup>
	import {
		colorToRgba,
		transformPixel,
		jumpLink
	} from '../utils.js'
	import { Header } from './headerType.uts'
	const props = defineProps({
		curData: {
			type: Object as PropType<Header>,
			default() {
				return {}
			}
		},
		pageBg: {
			type: String,
			default: ''
		},
		showBack: {
			type: Boolean,
			default: false
		}
	})
	const searchHieght = ref<number>(0)
	const searchStyle = ref<string>('')
	const iconStyle = ref<string>('')
	const paddingLeft = ref<string>('')
	const titleStyle = ref<string>('')
	const systemInfo = {}
	const rect = {}
	const header = ref<Header | null>(null)
	const isLoad = ref<boolean>(false)
	const justifyContent = {
		left: 'flex-start',
		center: 'center',
		right: 'flex-end'
	}

	const jumpSearchPage = () => {
		uni.showToast({
			title: '跳转搜索页'
		})
	}
	const backPage = () => {
		const pagesLen = getCurrentPages().length
		if (pagesLen > 1) {
			uni.navigateBack({
				delta: 1
			})
		} else {
			uni.reLaunch({
				url: '/pages/index/index'
			})
		}
	}

	const init = () => {
		header.value = {
			...props.curData.data
		}
		setSearchStyle()
		setIconStyle()
		setTitleStyle()
	}
	const setSearchStyle = () => {
		const { borderRadius, bgColor, opacity, color, textAlign } =
			header.value.search
		const { fontSize } = header.value.style
		const styleArr = []
		styleArr.push(`border-radius: ${transformPixel(borderRadius)}`)
		styleArr.push(
			`background-color: ${colorToRgba(bgColor, opacity)}`
		)
		styleArr.push(`font-size: ${transformPixel(fontSize)}`)
		styleArr.push(`color: ${color}`)
		styleArr.push(`text-align: ${textAlign}`)
		searchStyle.value = styleArr.join(';') + ';'
		searchHieght.value = rect.height
	}
	const setIconStyle = () => {
		const { iconPl, iconPr, pl } = header.value.style
		const styleArr = []
		paddingLeft.value = transformPixel(pl)
		iconStyle.value = `margin-right: ${transformPixel(
			iconPr
		)};`
	}
	const setTitleStyle = () => {
		const { fontSize, fontWeight, color } = header.value.style
		const styleArr = []
		styleArr.push(`font-weight: ${fontWeight}`)
		styleArr.push(`font-size: ${transformPixel(fontSize)}`)
		styleArr.push(`color: ${color}`)
		// #ifndef APP
		styleArr.push(
			`padding: 0 ${getApp().globalData.systemInfo.windowWidth
			}px;`
		)
		// #endif
		titleStyle.value = styleArr.join(';')
	}
	const iconLoad = () => {
		isLoad.value = true
	}
	const iconError = () => {
		isLoad.value = true
	}

	onMounted(() => {
		init();
	})
</script>

<style lang="scss">
	.com-header {
		.navigation-slot {
			display: flex;
			flex-direction: row;
			height: 100%;
			align-items: center;
			padding-right: 20rpx;
			overflow: hidden;
			position: relative;

			.default-back {
				position: absolute;
				top: 50%;
				width: 50rpx;
				height: 50rpx;
				background: url(bg('images/selmac/arrow-left-black.png')) no-repeat 0 center/36rpx 36rpx;
				transform: translateY(-50%);
				z-index: 2;
			}

			.prefix-icon {
				flex-shrink: 0;
				height: 100%;
				.img {
					width: auto;
					height: 100%;
				}
			}

			.search-bar {
				position: relative;
				flex: 1;
				height: 64rpx;
				// margin-top: 4px;
				overflow: hidden;
				padding: 0 30rpx;
				padding-left: 60rpx;
				display: flex;
				align-items: center;
				flex-direction: row;

				.search-icon {
					position: absolute;
					width: 40rpx;
					height: 40rpx;
					left: 14rpx;
					top: 50%;
					transform: translateY(-50%);
				}

				.search-inp {
					width: 100%;
					height: 100%;
					display: flex;
					align-items: center;
					flex-direction: row;
					pointer-events: none;
				}
			}

			.search-title {
				position: absolute;
				top: 50%;
				left: 0;
				width: 750rpx;
				transform: translateY(-50%);
				flex: 1;
				font-weight: normal;
				text-align: center;
				@include wordEllipsisNum(2);
			}
		}
	}
</style>